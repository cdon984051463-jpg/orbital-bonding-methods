&CONTROL
 calculation = 'scf', prefix = 'rc', outdir = './checkpoint', pseudo_dir = './pseudo/',
 tprnfor = .true., tstress = .false., verbosity = 'high', disk_io = 'nowf',
  max_seconds = 432000
/
&SYSTEM
 ibrav = 0, nat = 6, ntyp = 3, ecutwfc = 70, ecutrho = 560, nosym = .true.,
 occupations = 'smearing', smearing = 'gaussian', degauss = 0.01, nspin = 2, nbnd = 48, starting_magnetization(1) = 0.40, starting_magnetization(2) = -0.40,
/
&ELECTRONS
 conv_thr = 1e-14, mixing_beta = 0.3, electron_maxstep = 200,
 startingpot = 'atomic', startingwfc = 'atomic',
  diago_full_acc = .true.
/
