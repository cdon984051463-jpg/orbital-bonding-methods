&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'sc'
  outdir = './out/'
  pseudo_dir = './pseudo/'
  disk_io = 'nowf'
  tprnfor = .true.
  tstress = .false.
  verbosity = 'high'
  max_seconds = 432000
/
&SYSTEM
  ibrav = 0
  nat = 10
  ntyp = 2
  ecutwfc = 50
  ecutrho = 400
  input_dft = 'PBE'
  nspin = 1
  nosym = .true.
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1e-16
  electron_maxstep = 300
  mixing_beta = 0.3
  startingwfc = 'atomic'
  diago_full_acc = .true.
  diago_thr_init = 1e-12
/
